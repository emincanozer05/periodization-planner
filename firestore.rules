rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Senkron manifesti (doküman adı = uid) yazılırken `base`, buluttaki manifestin rev'i
       olmak ZORUNDA: yazan cihaz, arada başka bir cihazın yazdığı hâli görmeden onun üstüne
       yazamaz (çevrimdışı kuyruktan dönen eski yazım, aynı anda yazan iki cihaz). Reddedilen
       cihaz buluttakini okuyup kendi düzenlemesiyle birleştirir ve yeniden yazar.
       `base` taşımayan yazımlar (eski uygulama sürümleri, eski düzen) eskisi gibi geçer. */
    function syncHeadOk(docId) {
      return docId != request.auth.uid
        || !('base' in request.resource.data)
        || !('rev' in resource.data)
        || request.resource.data.base == resource.data.rev;
    }
    /* Senkron geçişi (docs/senkron-gecis-plani.md §7.4): hesap yeni yapıya taşınınca
       manifeste `migratedTo` yazılır ve eski yapı SALT OKUNUR olur. Önbellekteki eski bir
       uygulama sürümü artık yazamaz: ne manifesti, ne yeni bir parça. Taşınmamış hesaplarda
       (bugün hepsi) bu koşul hiçbir şeyi değiştirmez. */
    function legacyOpen() {
      let head = /databases/$(database)/documents/kullanici_verileri/$(request.auth.uid);
      return !exists(head) || !('migratedTo' in get(head).data);
    }
    match /kullanici_verileri/{docId} {
      allow read:   if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && legacyOpen();
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && syncHeadOk(docId)
                    && (!('migratedTo' in resource.data));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid && legacyOpen();
    }
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth.uid == uid;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       ÇALIŞMA ALANLARI — kayıt bazlı senkron (docs/senkron-gecis-plani.md §3,
       docs/veri-modeli.md). Henüz hiçbir uygulama sürümü buraya yazmıyor (Faz 2'ye kadar).

       workspaces/{ws}                       çalışma alanı; ws == sahibin uid'i (K3)
       workspaces/{ws}/members/{uid}         üyelik: role + teams (['*'] ya da takım kimlikleri)
       workspaces/{ws}/invites/{token}       davet linki; adresi bilen okur, kimse listeleyemez
       workspaces/{ws}/teams/{teamId}/**     takımın her şeyi (sezon, seans, sporcu, test, log)
       workspaces/{ws}/{col}/**              kulüp geneli: kütüphane, şablonlar, ayarlar…

       Roller (K2): owner · admin (üyeleri yönetir) · coach (düzenler) · viewer (yalnız görür).
       ═══════════════════════════════════════════════════════════════════════ */
    function wsMemberPath(ws) {
      return /databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid);
    }
    function isMember(ws) { return request.auth != null && exists(wsMemberPath(ws)); }
    function wsRole(ws)   { return get(wsMemberPath(ws)).data.role; }
    function wsTeams(ws)  { return get(wsMemberPath(ws)).data.teams; }
    function canWrite(ws) { return isMember(ws) && wsRole(ws) in ['owner', 'admin', 'coach']; }
    function canManage(ws){ return isMember(ws) && wsRole(ws) in ['owner', 'admin']; }
    function teamOk(ws, teamId) { return '*' in wsTeams(ws) || teamId in wsTeams(ws); }
    function validMember(d) {
      return d.keys().hasAll(['uid', 'role', 'teams'])
        && d.role in ['admin', 'coach', 'viewer']
        && d.teams is list && d.teams.size() >= 1 && d.teams.size() <= 100;
    }

    match /workspaces/{ws} {
      allow read: if isMember(ws);
      // Yalnızca kendi kimliğiyle ve kendisi sahip olarak; sahip üyeliği aynı batch'te yazılır.
      allow create: if request.auth != null && request.auth.uid == ws
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerUid == ws
        && existsAfter(wsMemberPath(ws))
        && getAfter(wsMemberPath(ws)).data.role == 'owner';
      allow update: if canManage(ws) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;   // hesap silme (sunucu) dışında silinmez

      match /members/{memberUid} {
        allow read: if isMember(ws);
        // Sahip üyeliği: yalnızca çalışma alanı kurulurken, sahibin kendisi.
        allow create: if request.auth != null && request.auth.uid == ws && memberUid == ws
            && request.resource.data.role == 'owner' && request.resource.data.uid == ws
            && request.resource.data.teams == ['*']
            && !exists(/databases/$(database)/documents/workspaces/$(ws))
          // Davetle katılma: kişi yalnızca KENDİ üyeliğini, davetteki rol ve takımlarla açar;
          // davet aynı batch'te bu kişi adına kullanıldı olarak işaretlenir.
          || (request.auth != null && memberUid == request.auth.uid && memberUid != ws
            && request.auth.token.firebase.sign_in_provider != 'anonymous'
            && validMember(request.resource.data) && request.resource.data.uid == memberUid
            && request.resource.data.invite is string
            && exists(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite))
            && get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite)).data.usedBy == null
            && get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite)).data.expiresAt > request.time
            && get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite)).data.teams == request.resource.data.teams
            && getAfter(/databases/$(database)/documents/workspaces/$(ws)/invites/$(request.resource.data.invite)).data.usedBy == memberUid)
          // Yönetici doğrudan ekler (sahip rolü verilemez).
          || (canManage(ws) && memberUid != ws && validMember(request.resource.data) && request.resource.data.uid == memberUid);
        // Rol/takım değişikliği yöneticinin; sahibin üyeliği değiştirilemez.
        allow update: if canManage(ws) && memberUid != ws && validMember(request.resource.data)
          && request.resource.data.uid == resource.data.uid;
        // Yönetici çıkarır; herkes kendisi ayrılabilir; sahip ayrılamaz.
        allow delete: if memberUid != ws && (canManage(ws) || (request.auth != null && request.auth.uid == memberUid));
      }

      match /invites/{token} {
        allow get: if request.auth != null;          // linki bilen (token gizli)
        allow list: if canManage(ws);
        allow create: if canManage(ws)
          && request.resource.data.role in ['admin', 'coach', 'viewer']
          && request.resource.data.teams is list && request.resource.data.teams.size() >= 1
          && request.resource.data.usedBy == null
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;
        // Kullanma: yalnızca usedBy, yalnızca kendisi, yalnızca bir kez, üyeliğiyle aynı batch'te.
        allow update: if request.auth != null && resource.data.usedBy == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == request.auth.uid
            && existsAfter(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid))
          || canManage(ws);
        allow delete: if canManage(ws);
      }

      // Takımın bütün alt verisi: üye ve o takıma erişimi var.
      match /teams/{teamId} {
        allow read: if isMember(ws) && teamOk(ws, teamId);
        allow create, update: if canWrite(ws) && teamOk(ws, teamId);
        allow delete: if canManage(ws) && teamOk(ws, teamId);
        /* {sub} en az bir segment ister: `{rest=**}` tek başına SIFIR segmentle de eşleşir
           ve takım belgesinin kendisini (silme dahil) koça açardı. */
        match /{sub}/{rest=**} {
          allow read: if isMember(ws) && teamOk(ws, teamId);
          allow write: if canWrite(ws) && teamOk(ws, teamId);
        }
      }

      // Kulüp geneli koleksiyonlar (K5): kütüphane, şablonlar, test tanımları, ayarlar…
      match /{col}/{docId=**} {
        allow read: if isMember(ws) && !(col in ['members', 'invites', 'teams']);
        allow write: if canWrite(ws) && !(col in ['members', 'invites', 'teams']);
      }
    }

    /* ABONELİK (docs/yayina-hazirlik-plani.md §3). Belgeyi YALNIZCA sunucu yazar
       (billingStatus function'ı, ileride ödeme sağlayıcısının webhook'u). Okuyan: hesabın
       sahibi ve o hesabın eşleşmiş ekip üyesi. İstemcinin kendine "aktif" yazabilmesi
       ücretsiz kullanım demek olurdu; bu yüzden yazım tamamen kapalı. */
    match /billing/{ws} {
      allow read: if request.auth != null && (
        request.auth.uid == ws
        || (exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
            && get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data.coachUid == ws));
      allow write: if false;
    }
    /* Hesap silme izi (functions/account/delete.js): belge adı uid'nin özeti, içinde
       yalnızca zaman ve silinen kayıt sayıları. Yalnızca sunucu yazar ve okur. */
    match /account_deletions/{id} {
      allow read, write: if false;
    }
    /* Aboneliğin genel ayarı (enforced, founderCutoff). Firebase Console'dan elle değişir. */
    match /config/billing {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Check-in linkleri: adresi (token) bilen okur, listeleyemez.
    match /checkin_links/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.coachUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.coachUid;
    }

    // Sporcu gönderimleri: yalnızca geçerli bir token ile YAZILIR, sonradan değiştirilemez.
    match /checkins/{id} {
      function ciMember() {
        return get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data;
      }
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['coachUid','teamId','athleteId','token','kind','date','payload'])
        && request.resource.data.keys().hasOnly(['coachUid','teamId','athleteId','athleteName','token','kind','date','payload','at','v'])
        && request.resource.data.kind in ['srpe','wellness']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 24
        && exists(/databases/$(database)/documents/checkin_links/$(request.resource.data.token))
        && get(/databases/$(database)/documents/checkin_links/$(request.resource.data.token)).data.coachUid == request.resource.data.coachUid
        && get(/databases/$(database)/documents/checkin_links/$(request.resource.data.token)).data.teamId == request.resource.data.teamId;
      /* Okuyan: hesabın sahibi ve eşleşmiş ekip üyesi — o da YALNIZCA kendi takımını
         (wellness_alerts ile aynı model). Ekip üyesinin telefon sayfası günün listesini
         artık doğrudan buradan kuruyor: liste bir sunucu fonksiyonuna (ve onun
         faturalandırma hesabına) bağlı kalmasın. */
      allow read: if request.auth != null && (
        resource.data.coachUid == request.auth.uid
        || (exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
            && ciMember().coachUid == resource.data.coachUid
            && ciMember().teamId   == resource.data.teamId));
      allow delete: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow update: if false;
    }

    /* ═══════════════════════════════════════════════════
       ANTRENMAN GÜNLÜĞÜ (lift.html) — set set kg / tekrar

       lift_plans/<token>_<sporcu>_<tarih>
         Koçun uygulaması sporcunun o günkü programını (egzersiz adı + hedef set/tekrar/yük)
         buraya yayımlar. Sporcu tek bir dokümanı ADIYLA okur (get); liste çıkarılamaz. Adın
         ilk parçası takım token'ı olduğu için token'ı bilmeyen hiçbir dokümana ulaşamaz —
         check-in linkleriyle aynı güven modeli. Yalnızca yayımlayan koç yazar/siler.

       lift_logs/<otomatik>
         Sporcunun gönderimi: check-in'lerdeki gibi yalnızca geçerli bir token ile YAZILIR
         ve sonradan değiştirilemez. Okuma ve silme yalnızca koçun (coachUid).
       ═══════════════════════════════════════════════════ */
    match /lift_plans/{planId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.coachUid
        && request.resource.data.token is string
        && planId.matches('^' + request.resource.data.token + '_.+$')
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 40;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.coachUid
        && request.auth.uid == request.resource.data.coachUid
        && request.resource.data.token == resource.data.token
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 40;
      allow delete: if request.auth != null && resource.data.coachUid == request.auth.uid;
    }

    match /lift_logs/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['coachUid','teamId','athleteId','token','date','ex','at'])
        && request.resource.data.keys().hasOnly(['coachUid','teamId','athleteId','athleteName','token','date','planId','ex','note','at','v'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.ex is list
        && request.resource.data.ex.size() >= 1
        && request.resource.data.ex.size() <= 40
        && exists(/databases/$(database)/documents/checkin_links/$(request.resource.data.token))
        && get(/databases/$(database)/documents/checkin_links/$(request.resource.data.token)).data.coachUid == request.resource.data.coachUid
        && get(/databases/$(database)/documents/checkin_links/$(request.resource.data.token)).data.teamId == request.resource.data.teamId;
      allow read, delete: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow update: if false;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       WELLNESS UYARILARI VE BİLDİRİM

       Dört koleksiyon. Ortak kural şu: uyarıyı YALNIZCA sunucu (Cloud Function)
       yazıyor, istemciler yalnızca okuyor. Admin SDK kuralların dışında çalıştığı
       için function'a ayrıca izin vermek gerekmiyor — aşağıdaki "write: if false"
       satırları function'ı değil, TARAYICIYI kapatıyor.

       Neden böyle: bir istemcinin uyarı üretebilmesi, o istemcinin başka
       kullanıcıların telefonuna bildirim gönderebilmesi demek olurdu (Madde 16).
       ═══════════════════════════════════════════════════════════════════════ */

    /* Bir ekip üyesinin eşleşme kaydı. Anonim oturum kendi kaydını bir kez
       yazıyor; kim olduğunu SÖYLEMİYOR — hangi kadro satırına ait olduğunu
       elindeki token'ın arkasındaki staff_links dokümanı söylüyor ve kayıt ona
       birebir uymak zorunda. Yani "ben baş antrenörüm" diyerek başka bir takımın
       uyarılarına geçilemiyor. */
    match /staff_members/{authUid} {
      function link() {
        return get(/databases/$(database)/documents/staff_links/$(request.resource.data.token)).data;
      }
      allow get: if request.auth != null && request.auth.uid == authUid;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == authUid
        && request.resource.data.keys().hasAll(['coachUid','teamId','staffId','token'])
        && exists(/databases/$(database)/documents/staff_links/$(request.resource.data.token))
        && link().coachUid == request.resource.data.coachUid
        && link().teamId   == request.resource.data.teamId
        && link().staffId  == request.resource.data.staffId;
      allow delete: if request.auth != null && request.auth.uid == authUid;
    }

    /* Ekip üyesinin bildirim linki. Check-in linkleriyle aynı model: adresi bilen
       okur, kimse listeleyemez. Linki üreten ve silen yalnızca hesabın sahibi. */
    match /staff_links/{token} {
      allow get:    if true;
      allow list:   if false;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.coachUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.coachUid;
    }

    /* Takımın kadro özeti — function'ın "bu sporcunun uyarısı kime gider"
       sorusunu cevaplamak için okuduğu tek doküman. Koçun uygulaması yazıyor.
       Eşleşmiş ekip üyesi de YALNIZCA kendi takımınınkini tek tek okuyabiliyor
       (listeleyemiyor): sayfasındaki "kim doldurdu, kim doldurmadı" şeridi
       sporcu listesini buradan alıyor. */
    match /alert_roster/{docId} {
      function member() {
        return get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data;
      }
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow get: if request.auth != null
        && exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
        && member().coachUid == resource.data.coachUid
        && member().teamId   == resource.data.teamId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.coachUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.coachUid;
    }

    /* Cihaz kayıtları (bildirim token'ları).

       Bir kullanıcı YALNIZCA kendi oturumuna ait kaydı yazabiliyor ve kaydın
       kapsamı (hangi hesap, hangi takım, hangi kadro satırı) elindeki eşleşme
       kaydından doğrulanıyor. Kendi kaydını başka bir takıma yazamıyor.

       Okuma tamamen kapalı: token listesi kimsenin görmesi gereken bir şey değil,
       onu yalnızca gönderimi yapan function (admin SDK) okuyor. */
    match /push_tokens/{fcmToken} {
      function member() {
        return get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data;
      }
      allow read, list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['coach','staff']
        && (
          // Hesap sahibinin kendi cihazı: coachUid kendi kimliği olmak zorunda.
          (request.resource.data.kind == 'coach'
            && request.resource.data.coachUid == request.auth.uid)
          ||
          // Ekip üyesinin cihazı: eşleşme kaydıyla birebir uymak zorunda.
          (request.resource.data.kind == 'staff'
            && exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
            && member().coachUid == request.resource.data.coachUid
            && member().teamId   == request.resource.data.teamId
            && member().staffId  == request.resource.data.staffId)
        );
      // Kendi cihazını kaydından düşürebilmeli (bildirimi kapatmak).
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    /* Uyarı kayıtları.

       Okuyabilenler yalnızca iki taraf:
         • hesabın sahibi (koç) — kendi tüm takımlarını,
         • eşleşmiş ekip üyesi — YALNIZCA kendi takımını.

       İkinci satır, bir ekip üyesinin başka bir takımın ya da başka bir kulübün
       uyarılarını görmesini kapatıyor: eşleşme kaydındaki teamId ile uyarının
       teamId'si aynı olmak zorunda.

       Yazma tamamen kapalı — uyarıyı yalnızca Cloud Function üretiyor. */
    /* ═══════════════════════════════════════════════════════════════════════
       YAPAY ZEKÂ PROGRAM ÜRETİM İŞLERİ (AI_RELIABILITY.md)

       Uygulama işi BAŞLATIR ve İZLER; yürüten Cloud Function'dır. Gemini anahtarı
       yalnızca function'ın ortamında durur — bu koleksiyonların hiçbirinde yok.

       Koçun yapabildiği üç şey var:
         • kendi adına, QUEUED durumunda, yalnızca istek alanlarıyla bir iş açmak
           (aynı kimlikle ikinci bir oluşturma "create" olmadığı için reddedilir),
         • CoachOS Kural Denetleyicisinin sonucunu (ruleCheck) yalnızca sunucunun
           sorduğu tur için yazmak,
         • tamamlanmış bir işin sonucunun takvime yazımını BİR KEZ sahiplenmek
           (pending → claimed → written) ya da işi iptal istemek.
       Durum, bütçe, model, sonuç ve hata alanlarını yalnızca function yazar. */
    match /ai_generation_jobs/{jobId} {
      function mine() { return request.auth != null && resource.data.uid == request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read: if mine();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'QUEUED'
        && request.resource.data.keys().hasOnly(['uid','teamId','athleteId','srcKey','date','status',
             'createdAt','request','libraryIndex','clientNonce','v'])
        && request.resource.data.keys().hasAll(['uid','athleteId','srcKey','date','status','request'])
        && request.resource.data.request is map
        && request.resource.data.request.system is string
        && request.resource.data.request.user is string
        && request.resource.data.request.system.size() <= 80000
        && request.resource.data.request.user.size() <= 700000;
      allow update: if mine() && (
        // Kural denetleyicisinin sonucu — yalnızca sorulan tur için, doğrulama sürerken.
        (changed().hasOnly(['ruleCheck'])
          && resource.data.status == 'VALIDATING'
          && request.resource.data.ruleCheck.round == resource.data.ruleCheckRound
          && request.resource.data.ruleCheck.status in ['pass','fail'])
        ||
        // Takvime yazımın tek seferlik sahiplenilmesi.
        (changed().hasOnly(['calendarWriteStatus','calendarWrittenAt'])
          && resource.data.status == 'COMPLETED'
          && resource.data.validationStatus == 'pass'
          && ((resource.data.calendarWriteStatus == 'pending' && request.resource.data.calendarWriteStatus == 'claimed')
           || (resource.data.calendarWriteStatus == 'claimed' && request.resource.data.calendarWriteStatus in ['written','pending'])))
        ||
        // İptal isteği.
        (changed().hasOnly(['cancelRequested']) && request.resource.data.cancelRequested == true)
      );
      allow delete: if false;
    }
    /* Aktif üretim kilidi, kullanım sayacı ve bağlam önbelleği kaydı: yalnızca
       function (admin SDK) okur/yazar. */
    match /ai_generation_locks/{id} { allow read, write: if false; }
    match /ai_usage/{uid}          { allow read, write: if false; }
    match /ai_context_cache/{id}   { allow read, write: if false; }

    match /wellness_alerts/{alertId} {
      function member() {
        return get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data;
      }
      function isOwner() {
        return request.auth != null && resource.data.coachUid == request.auth.uid;
      }
      function isTeamStaff() {
        return request.auth != null
          && exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
          && member().coachUid == resource.data.coachUid
          && member().teamId   == resource.data.teamId;
      }
      allow read: if isOwner() || isTeamStaff();
      allow write: if false;
    }

    /* Antrenman sonrası RPE kayıtları — ekip üyesinin telefonundaki RPE sekmesi.
       Uyarı kayıtlarıyla aynı model: yalnızca Cloud Function yazıyor, okuyan hesabın
       sahibi ve eşleşmiş ekip üyesi — o da YALNIZCA kendi takımını. */
    match /rpe_reports/{reportId} {
      function member() {
        return get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data;
      }
      function isOwner() {
        return request.auth != null && resource.data.coachUid == request.auth.uid;
      }
      function isTeamStaff() {
        return request.auth != null
          && exists(/databases/$(database)/documents/staff_members/$(request.auth.uid))
          && member().coachUid == resource.data.coachUid
          && member().teamId   == resource.data.teamId;
      }
      allow read: if isOwner() || isTeamStaff();
      allow write: if false;
    }

    /* ═══════════════════════════════════════════════════════════════════════
       POLAR ACCESSLINK (functions/polar)

       Hepsini YALNIZCA sunucu (polarApi, Admin SDK) yazıyor; Admin SDK kuralların
       dışında çalıştığı için aşağıdaki "write: if false" satırları tarayıcıyı
       kapatıyor, function'ı değil.

       Token, OAuth state, davet ve "Polar kullanıcısı → sporcu" eşleşmesi
       istemciye TAMAMEN kapalı: okuma da yok. Erişim token'ı ayrıca şifreli.
       Bağlantı durumunu yalnızca hesabın sahibi (coachUid) okuyor; ekip üyeleri
       (anonim oturum) görmüyor.
       ═══════════════════════════════════════════════════════════════════════ */
    match /polar_tokens/{id}       { allow read, write: if false; }
    match /polar_oauth_states/{id} { allow read, write: if false; }
    match /polar_tickets/{id}      { allow read, write: if false; }
    match /polar_users/{id}        { allow read, write: if false; }

    match /polar_links/{linkId} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }

    /* Polar'dan çekilen veri (Aşama 2): uyku, Nightly Recharge, antrenman, günlük
       aktivite, kardiyo yükü, sürekli nabzın günlük özeti. Yalnızca hesabın sahibi okur; yazan yalnızca sunucu.
       Sporcunun senkronlanan kendi verisinden AYRI tutuluyor, onun üzerine yazılmıyor. */
    match /polar_sleep/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
    match /polar_recharge/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
    match /polar_exercises/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
    match /polar_activity/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
    match /polar_cardio_load/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
    match /polar_hr_daily/{id} {
      allow read: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow write: if false;
    }
  }
}
